# Copy this file to .env in the repository root.
# demo = temporary in-memory data; mongodb = persistent Atlas data.
DATA_MODE=demo
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=ecom_app
PORT=4000
HOST=127.0.0.1
TRUST_PROXY_HOPS=0
CLIENT_ORIGIN=http://localhost:4200
NODE_ENV=development
# Optional, process-local DNS override if your ISP blocks Atlas SRV lookups.
# NODE_DNS_SERVERS=1.1.1.1,8.8.8.8
